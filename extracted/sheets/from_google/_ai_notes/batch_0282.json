  {
    "row": 289,
    "type": "NOTE:FULL",
    "editor": "VNCREmbassyCrockerLog4",
    "en": "Fiend Report"
  },
  {
    "row": 290,
    "type": "NOTE:TNAM",
    "editor": "VNCREmbassyCrockerLog4",
    "en": "The Fiends have been more active outside New Vegas. The NCR troops stationed at Camp McCarran are handling this for now, but the situation needs to be monitored."
  },
  {
    "row": 291,
    "type": "NOTE:FULL",
    "editor": "VNCREmbassyCrockerLog3",
    "en": "Farming Report"
  },
  {
    "row": 292,
    "type": "NOTE:TNAM",
    "editor": "VNCREmbassyCrockerLog3",
    "en": "Our farms on the east side of New Vegas are producing a good amount of crops. With the additional water allocated from Hoover Dam, we can increase the number of farms over the next few years by a substantial amount. That means more residents inclined to vote for annexation."
  },
  {
    "row": 293,
    "type": "NOTE:FULL",
    "editor": "VNCREmbassyCrockerLog2",
    "en": "Freeside Report"
  },
  {
    "row": 294,
    "type": "NOTE:TNAM",
    "editor": "VNCREmbassyCrockerLog2",
    "en": "Reports are coming in from Freeside detailing a rise in violence against NCR Citizens. We're going to need to look into this. All sources indicate that Pacer is involved, of course."
  },
  {
    "row": 295,
    "type": "NOTE:FULL",
    "editor": "VNCREmbassyCrockerLog1",
    "en": "Informant Report"
  },
  {
    "row": 296,
    "type": "NOTE:TNAM",
    "editor": "VNCREmbassyCrockerLog1",
    "en": "Latest information from our inside source reports that the Omertas are unhappy with House. We may be able to use this as leverage against him."
  },
